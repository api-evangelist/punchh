        "name": "Remove Item From Discount Basket (Redemptions 2.0)",
        "type": "http"
      },
      "http": {
        "method": "DELETE",
        "url": "https://SERVER_NAME_GOES_HERE.punchh.com/api2/mobile/discounts/unselect",
        "headers": [
